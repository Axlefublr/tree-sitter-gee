{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/grammar.schema.json",
  "name": "gee",
  "rules": {
    "source_file": {
      "type": "SEQ",
      "members": [
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "SYMBOL",
              "name": "_separator"
            },
            {
              "type": "BLANK"
            }
          ]
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "SEQ",
              "members": [
                {
                  "type": "SYMBOL",
                  "name": "_block"
                },
                {
                  "type": "REPEAT",
                  "content": {
                    "type": "SEQ",
                    "members": [
                      {
                        "type": "SYMBOL",
                        "name": "_separator"
                      },
                      {
                        "type": "SYMBOL",
                        "name": "_block"
                      }
                    ]
                  }
                },
                {
                  "type": "CHOICE",
                  "members": [
                    {
                      "type": "SYMBOL",
                      "name": "_separator"
                    },
                    {
                      "type": "BLANK"
                    }
                  ]
                }
              ]
            },
            {
              "type": "BLANK"
            }
          ]
        }
      ]
    },
    "_block": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SYMBOL",
          "name": "paragraph"
        }
      ]
    },
    "paragraph": {
      "type": "REPEAT1",
      "content": {
        "type": "SYMBOL",
        "name": "line"
      }
    },
    "line": {
      "type": "SEQ",
      "members": [
        {
          "type": "REPEAT1",
          "content": {
            "type": "CHOICE",
            "members": [
              {
                "type": "SYMBOL",
                "name": "_space"
              },
              {
                "type": "SYMBOL",
                "name": "_word"
              }
            ]
          }
        },
        {
          "type": "SYMBOL",
          "name": "_newline"
        }
      ]
    },
    "_word_bold": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SYMBOL",
          "name": "italic"
        },
        {
          "type": "REPEAT1",
          "content": {
            "type": "CHOICE",
            "members": [
              {
                "type": "SYMBOL",
                "name": "_stray_in_bold"
              },
              {
                "type": "SYMBOL",
                "name": "_plain"
              }
            ]
          }
        }
      ]
    },
    "_word_italic": {
      "type": "REPEAT1",
      "content": {
        "type": "CHOICE",
        "members": [
          {
            "type": "SYMBOL",
            "name": "_raw_in_italic"
          },
          {
            "type": "SYMBOL",
            "name": "_plain"
          }
        ]
      }
    },
    "_word": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SYMBOL",
          "name": "italic"
        },
        {
          "type": "SYMBOL",
          "name": "bold"
        },
        {
          "type": "SYMBOL",
          "name": "_plain"
        },
        {
          "type": "SYMBOL",
          "name": "_stray"
        }
      ]
    },
    "inner_bold": {
      "type": "SEQ",
      "members": [
        {
          "type": "SYMBOL",
          "name": "_word_bold"
        },
        {
          "type": "REPEAT",
          "content": {
            "type": "SEQ",
            "members": [
              {
                "type": "SYMBOL",
                "name": "_space"
              },
              {
                "type": "SYMBOL",
                "name": "_word_bold"
              }
            ]
          }
        }
      ]
    },
    "inner_italic": {
      "type": "SEQ",
      "members": [
        {
          "type": "SYMBOL",
          "name": "_word_italic"
        },
        {
          "type": "REPEAT",
          "content": {
            "type": "SEQ",
            "members": [
              {
                "type": "SYMBOL",
                "name": "_space"
              },
              {
                "type": "SYMBOL",
                "name": "_word_italic"
              }
            ]
          }
        }
      ]
    },
    "bold": {
      "type": "PREC_DYNAMIC",
      "value": 10,
      "content": {
        "type": "SEQ",
        "members": [
          {
            "type": "STRING",
            "value": "*"
          },
          {
            "type": "SYMBOL",
            "name": "inner_bold"
          },
          {
            "type": "STRING",
            "value": "*"
          }
        ]
      }
    },
    "italic": {
      "type": "PREC_DYNAMIC",
      "value": 1,
      "content": {
        "type": "SEQ",
        "members": [
          {
            "type": "STRING",
            "value": "/"
          },
          {
            "type": "SYMBOL",
            "name": "inner_italic"
          },
          {
            "type": "STRING",
            "value": "/"
          }
        ]
      }
    },
    "_raw_in_italic": {
      "type": "STRING",
      "value": "*"
    },
    "_stray_in_bold": {
      "type": "STRING",
      "value": "/"
    },
    "_stray": {
      "type": "CHOICE",
      "members": [
        {
          "type": "STRING",
          "value": "/"
        },
        {
          "type": "STRING",
          "value": "*"
        }
      ]
    },
    "_plain": {
      "type": "PATTERN",
      "value": "[^\\s/*]+"
    },
    "_separator": {
      "type": "PATTERN",
      "value": "(([ \\t]*)\\n)+"
    },
    "_newline": {
      "type": "STRING",
      "value": "\n"
    },
    "_space": {
      "type": "PATTERN",
      "value": "[ \\t]+"
    }
  },
  "extras": [],
  "conflicts": [
    [
      "bold",
      "_stray"
    ],
    [
      "italic",
      "_stray"
    ],
    [
      "italic",
      "_stray_in_bold"
    ]
  ],
  "precedences": [],
  "externals": [],
  "inline": [],
  "supertypes": [],
  "reserved": {}
}